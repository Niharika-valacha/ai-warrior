# Copy to .env and fill in. Without keys the game still works: the replay model and snapshots take over.

# Multiplayer data. Unset = a local SQLite file. For Postgres: docker compose up -d, then alembic upgrade head.
# DATABASE_URL=postgresql+asyncpg://aiwarrior:aiwarrior@127.0.0.1:5435/aiwarrior

# LLM providers, tried in this order; any without a key is skipped. Both have free tiers.
LLM_PROVIDERS=groq,gemini
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Web search for side quests and "Ask live"
TAVILY_API_KEY=

# Protects the content editing endpoints (see /docs)
ADMIN_TOKEN=
